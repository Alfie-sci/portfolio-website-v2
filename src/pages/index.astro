---
import { Image } from 'astro:assets';

import photo1 from '../assets/gallery/photo1.jpeg';
import photo2 from '../assets/gallery/photo2.jpeg';
import photo3 from '../assets/gallery/photo3.jpeg';
import photo4 from '../assets/gallery/photo4.jpeg';
import photo5 from '../assets/gallery/photo5.jpeg';
import photo6 from '../assets/gallery/photo6.jpeg';
import photo7 from '../assets/gallery/photo7.jpeg';
import photo8 from '../assets/gallery/photo8.jpeg';
import photo9 from '../assets/gallery/photo9.jpeg';

const photos = [
	{ title: "Engineering Two", asset: photo1 },
	{ title: "Auto Train", asset: photo2 },
	{ title: "Glasson Dock 9", asset: photo3 },
	{ title: "Evening Star 92220", asset: photo4 },
	{ title: "Turbine 01", asset: photo5 },
	{ title: "Colour Signals 08", asset: photo6 },
	{ title: "Picadilly 67", asset: photo7 },
	{ title: "Traffic Light", asset: photo8 },
	{ title: "Lane 3", asset: photo9 },
];

const projects = [
	{
		name: "Portfolio v2",
		href: "https://github.com/Alfie-Sci/portfolio-website",
		stack: "Astro, CSS, Cloudflare Pages",
		text: "This website. Built with semantic HTML and CSS and no client-side JavaScript, partly for fast loads and partly as a challenge to myself.",
		link: { href: "https://alfieralls.com", label: "alfieralls.com" },
	},
	{
		name: "RailGraph UK",
		href: "https://github.com/Alfie-Sci/RailGraph",
		stack: "React, deck.gl, OpenStreetMap",
		text: "An open-source interactive map of how the UK railway network has changed over time, with a timeline scroller. Currently focused on Yorkshire's closed branch lines. The data is messy and needs lots of manual review, but the result is worth it.",
		link: { href: "https://railgraph.co.uk", label: "railgraph.co.uk" },
	},
	{
		name: "Pi Departure Board",
		stack: "Raspberry Pi Zero W, Python, Bash",
		text: "A planned hardware display that pulls live train movements for a chosen location from the Realtime Trains API. Waiting for hardware prices to settle before buying the parts.",
	},
	{
		name: "Optiplex Homelab",
		stack: "Proxmox, Docker, Samba",
		text: "A legacy Dell Optiplex running Proxmox and an Ubuntu VM with Nextcloud, Immich and Pi-hole, plus Portainer and Uptime Kuma to keep an eye on things.",
	},
];

---

<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="description" content="Alfie Ralls: Computer Science student, tinkerer, railway enthusiast.">
	<meta name="theme-color" content="#0059a6">
	<title>Alfie Ralls</title>
	<link rel="icon" type="image/png" href="/favicon.png" />
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Doto:wght@300;400;500;700&display=swap">
	<style is:global>
		:root {
			color-scheme: light dark;

			/* The wall the signs are mounted on */
			--wall: light-dark(#e4e4df, #1b1d21);
			--wall-text: light-dark(#3b3b38, #a9acb2);

			/* Sign colours (these stay the same in light and dark mode) */
			--blue: #0059a6;
			--black: #131313;
			--white: #ffffff;
			--yellow: #ffd100;
			--amber: #ffaa00;
			--amber-dim: #cc8800;
			--green: #00ff00;
			--grey: #5a5a5a;
			--line: #d6d6d1;

			/* Rail Alphabet 2 first, if you ever self-host it, then close lookalikes */
			--sans: "Rail Alphabet 2", "Rail Alphabet", "Helvetica Neue", Helvetica, Arial, "Liberation Sans", sans-serif;
			--dots: 'Doto', ui-monospace, "SF Mono", Menlo, Consolas, monospace;
		}

		* { box-sizing: border-box; }
		html { scroll-behavior: smooth; }

		body {
			margin: 0;
			background: var(--wall);
			color: var(--wall-text);
			font-family: var(--sans);
			line-height: 1.55;
		}

		:focus-visible { outline: 3px solid var(--yellow); outline-offset: 3px; }

		/* ---------- Signs ---------- */
		.sign {
			--bg: var(--black);
			--fg: var(--white);
			--radius: 1rem;
			--inset: 0.4rem;
			position: relative;
			background: var(--bg);
			color: var(--fg);
			border-radius: var(--radius);
			padding: clamp(1.25rem, 3vw, 2rem);
			box-shadow: 0 6px 16px rgba(0, 0, 0, 0.22);
		}

		/* The thin keyline just inside the edge, with a concentric corner radius
		   so it follows the sign's rounded corners cleanly */
		.sign::before {
			content: "";
			position: absolute;
			inset: var(--inset);
			border: 3px solid var(--fg);
			border-radius: calc(var(--radius) - var(--inset));
			pointer-events: none;
		}

		/* 1980s InterCity livery: grey enamel with red and white stripes */
		.sign--intercity {
			--bg: #474c51;
			--ic-red: #d0202b;
			/* extra room at the bottom for the stripe */
			padding-bottom: calc(clamp(1.25rem, 3vw, 2rem) + 1.9rem);
		}

		/* keep the full keyline frame (including its bottom edge and rounded
           corners) and fill the bottom of it with the white band */
		.sign--intercity::before {
			background: linear-gradient(to top, #fff 0 2.2rem, transparent 2.2rem);
		}

		.sign--intercity .stripes {
			position: absolute;
			left: calc(var(--inset) + 3px);
			right: calc(var(--inset) + 3px);
			bottom: 1.05rem;
			height: 0.9rem;
			background: var(--ic-red);
		}

		/* Corner bolts, like a real enamel sign */
		.sign--intercity .bolt {
			position: absolute;
			width: 0.55rem;
			height: 0.55rem;
			border-radius: 50%;
			background: radial-gradient(circle at 35% 35%, #ffffff, #a3abb5 60%, #5b6472);
		}
		.bolt--tl { top: 0.85rem; left: 0.85rem; }
		.bolt--tr { top: 0.85rem; right: 0.85rem; }
		.bolt--bl { bottom: 0.85rem; left: 0.85rem; }
		.bolt--br { bottom: 0.85rem; right: 0.85rem; }


		/* ---------- Landing page ---------- */
		.hero {
			width: min(72rem, calc(100% - 2rem));
			min-height: 100svh;
			margin: 0 auto;
			padding: clamp(1rem, 3vw, 2.5rem) 0;
			display: grid;
			align-content: center;
			gap: clamp(0.75rem, 1.6vw, 1.25rem);
		}

		.nameboard {
			display: flex;
			align-items: center;
			gap: clamp(1rem, 3vw, 2rem);
		}

		.logo { flex: none; width: auto; height: clamp(4rem, 10vw, 7rem); }

		.nameboard h1 {
			margin: 0;
			font-size: clamp(2.6rem, 8.5vw, 6.5rem);
			font-weight: 700;
			letter-spacing: -0.035em;
			line-height: 0.95;
		}

		.nameboard p {
			margin: 0.7rem 0 0;
			font-size: clamp(1rem, 2.4vw, 1.55rem);
			font-weight: 400;
		}

		/* ---------- Departure board ---------- */
		.board {
			--bg: #050505;
			--fg: #3a3a3a;               /* subtle grey bezel line */
			color: var(--amber);
			font-family: var(--dots);
			font-variation-settings: "ROND" 100;
			font-weight: 500;
			letter-spacing: 0.05em;
		}

		.board-title {
			margin: 0 0 0.9rem;
			font-family: var(--sans);
			font-size: 0.95rem;
			font-weight: 700;
			letter-spacing: 0;
			color: var(--white);
		}

		.cis-board { font-size: clamp(1.05rem, 2.5vw, 1.9rem); }

		.cis-on-time { color: var(--green); text-shadow: 0 0 5px rgba(0, 255, 0, 0.4); }

		.cis-row {
			display: flex;
			justify-content: flex-start;
			text-shadow: 0 0 1px rgba(255, 170, 0, 0.5);
		}

		.cis-colon {
			color: transparent;
			text-shadow: none;
			position: relative;
			display: inline-block;
			width: 0.5em;
		}
		.cis-colon::after {
			content: ""; position: absolute; left: 40%; top: 35%;
			transform: translateX(-50%); width: 2px; height: 2px;
			background-color: var(--amber); box-shadow: 0 8px 0 var(--amber);
		}

		.cis-rank   { width: 2.6em; flex: none; }
		.cis-time   { width: 4em; flex: none; }
		.cis-plat   { width: 2.4em; flex: none; text-align: center; }
		.cis-dest   { flex: 1; min-width: 0; padding-left: 0.9em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
		.cis-status { width: 6em; flex: none; text-align: right; }

		.cis-scroll-row {
			display: flex;
			font-size: 0.8em;
			margin-bottom: 0.9em;
			padding-bottom: 0.6em;
			background-image: linear-gradient(to right, var(--amber-dim) 1px, transparent 1px);
			background-size: 2px 1px;
			background-position: bottom left;
			background-repeat: repeat-x;
		}
		.cis-board > div:last-child { background-image: none; margin-bottom: 0; padding-bottom: 0; }

		.cis-calling-label { white-space: nowrap; margin-right: 1rem; color: var(--amber-dim); }
		.cis-scroll-container { flex-grow: 1; overflow: hidden; position: relative; container-type: inline-size; }
		.cis-scroll-text {
			display: inline-block;
			white-space: nowrap;
			animation: cis-scroll linear infinite;
			will-change: transform;
			transform: translateZ(0);
			backface-visibility: hidden;
		}
		@keyframes cis-scroll {
			0%   { transform: translate3d(100cqi, 0, 0); }
			100% { transform: translate3d(-100%, 0, 0); }
		}

		.cis-blink { animation: cis-blinker 2s step-start infinite; }
		@keyframes cis-blinker { 50% { opacity: 0; } }

		.board-note {
			margin: 1.1rem 0 0;
			font-family: var(--sans);
			font-size: 0.85rem;
			font-weight: 400;
			letter-spacing: 0;
			color: #8a8a8a;
		}

		/* ---------- Leaflets ---------- */
		main {
			width: min(52rem, calc(100% - 2rem));
			margin: 0 auto;
			padding: 1rem 0 0;
		}

		/* Shared: a tri-folded paper leaflet */
		.leaflet {
			--paper: #fbf9f3;
			--accent: var(--blue);
			position: relative;
			background: var(--paper);
			color: #151515;
			margin: 0 0 2.25rem;
			scroll-margin-top: 1rem;
			overflow: hidden;
			box-shadow: 0 1px 2px rgba(0, 0, 0, 0.12), 0 10px 22px rgba(0, 0, 0, 0.2);
		}

		/* the two fold creases */
		.leaflet::after {
			content: "";
			position: absolute;
			inset: 0;
			pointer-events: none;
			background: linear-gradient(
				90deg,
				transparent calc(33.333% - 1px), rgba(0, 0, 0, 0.07) 33.333%, rgba(255, 255, 255, 0.45) calc(33.333% + 1px), transparent calc(33.333% + 3px),
				transparent calc(66.666% - 1px), rgba(0, 0, 0, 0.07) 66.666%, rgba(255, 255, 255, 0.45) calc(66.666% + 1px), transparent calc(66.666% + 3px)
			);
		}

		.leaflet-head { position: relative; padding: 1.5rem 1.75rem 2.4rem; }

		.leaflet-head .eyebrow { margin: 0 0 0.4rem; font-size: 1rem; font-weight: 400; }

		.leaflet-head h2 {
			margin: 0;
			font-size: clamp(2.4rem, 7vw, 4rem);
			font-weight: 700;
			letter-spacing: -0.035em;
			line-height: 0.95;
		}

		.leaflet-body { padding: 1.75rem; }
		.leaflet-body > :last-child { margin-bottom: 0; }

		.leaflet p { margin: 0 0 1rem; font-size: 1.05rem; }
		.leaflet a { color: var(--accent); text-underline-offset: 3px; }
		.leaflet a:hover { color: #151515; }

		/* 1. About: grey enamel and red/white stripes, InterCity style */
		.leaflet--about { --accent: #d0202b; }
		.leaflet--about .leaflet-head { background: #474c51; color: #fff; padding-bottom: 3.4rem; }
		.leaflet--about .leaflet-head::after {
			content: "";
			position: absolute;
			left: 0;
			right: 0;
			bottom: 0;
			height: 1.6rem;
			background: linear-gradient(#d0202b 0 38%, transparent 38% 55%, #fff 55% 88%, transparent 88%);
		}
		.leaflet--about .leaflet-body > p:first-child { font-size: 1.35rem; font-weight: 700; line-height: 1.35; }

		.skills {
			margin-top: 1.5rem;
			padding: 1rem 1.25rem;
			background: #ecebe5;
			border-left: 0.4rem solid var(--accent);
		}
		.skills p { margin: 0; font-size: 0.95rem; line-height: 1.9; }

		/* 2. Projects: bright blue with diagonal red/white bands, Network SouthEast style */
		.leaflet--projects { --accent: #1c5bb5; }
		.leaflet--projects .leaflet-head {
			color: #fff;
			background: linear-gradient(
				115deg,
				#1c5bb5 0 60%, #fff 60% 63%, #e2231a 63% 76%, #fff 76% 79%, #14397e 79% 100%
			);
		}
		.leaflet--projects .leaflet-body { counter-reset: svc; }

		.project {
			counter-increment: svc;
			display: grid;
			grid-template-columns: 2.8rem 1fr;
			column-gap: 1rem;
		}
		.project::before {
			content: counter(svc);
			grid-column: 1;
			grid-row: 1 / span 4;
			align-self: start;
			display: grid;
			place-items: center;
			width: 2.8rem;
			height: 2.8rem;
			background: var(--accent);
			color: #fff;
			font-weight: 700;
			font-size: 1.5rem;
		}
		.project > * { grid-column: 2; }
		.project + .project { margin-top: 1.5rem; padding-top: 1.5rem; border-top: 2px dotted var(--accent); }
		.project h3 { margin: 0; font-size: 1.35rem; letter-spacing: -0.01em; }
		.project h3 a { color: #151515; }
		.project h3 a:hover { color: var(--accent); }
		.stack { margin: 0.2rem 0 0.6rem !important; font-size: 0.85rem !important; font-weight: 700; color: var(--accent); }

		/* 3. Photographs: yellow "day out" leaflet with halftone dots and a sticker */
		.leaflet--photos { --paper: #fff7c9; --accent: #151515; }
		.leaflet--photos .leaflet-head { background: #ffd100; color: #131313; border-bottom: 0.55rem solid #131313; }
		.leaflet--photos .leaflet-head::before {
			content: "";
			position: absolute;
			inset: 0 0 0 40%;
			background-image: radial-gradient(circle, #131313 24%, transparent 26%);
			background-size: 14px 14px;
			-webkit-mask-image: linear-gradient(to left, #000, transparent);
			mask-image: linear-gradient(to left, #000, transparent);
			opacity: 0.85;
		}
		.leaflet--photos .leaflet-head > :not(.sticker) { position: relative; }

		.sticker {
			position: absolute;
			right: 1.75rem;
			top: 50%;
			display: grid;
			place-items: center;
			width: 5.4rem;
			height: 5.4rem;
			border-radius: 50%;
			background: #d0202b;
			color: #fff;
			font-size: 1.2rem;
			font-weight: 700;
			line-height: 1;
			text-align: center;
			transform: translateY(-50%) rotate(-12deg);
			box-shadow: 0 2px 0 rgba(0, 0, 0, 0.3);
		}

		.gallery {
			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
			gap: 1.25rem;
			margin: 0;
			padding: 0;
			list-style: none;
		}

		.gallery figure {
			margin: 0;
			padding: 0.4rem 0.4rem 0;
			background: #fff;
			box-shadow: 0 3px 8px rgba(0, 0, 0, 0.25);
		}
		.gallery li:nth-child(odd) figure { transform: rotate(-0.8deg); }
		.gallery li:nth-child(even) figure { transform: rotate(0.8deg); }
		.gallery img { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
		.gallery figcaption {
			margin: 0.4rem -0.4rem 0;
			padding: 0.4rem 0.7rem;
			background: #131313;
			color: #ffd100;
			font-size: 0.85rem;
			font-weight: 700;
		}

		/* 4. Contact: narrower red enquiries leaflet with a cut-out coupon */
		.leaflet--contact { --accent: #b3151f; max-width: 38rem; margin-right: auto; margin-left: auto; }
		.leaflet--contact .leaflet-head { background: #d0202b; color: #fff; padding-bottom: 2rem; }
		.leaflet--contact .leaflet-head::before {
			content: "";
			position: absolute;
			inset: 0 0 0 50%;
			background: repeating-linear-gradient(135deg, rgba(255, 255, 255, 0.24) 0 0.7rem, transparent 0.7rem 1.4rem);
			-webkit-mask-image: linear-gradient(to left, #000, transparent);
			mask-image: linear-gradient(to left, #000, transparent);
		}
		.leaflet--contact .leaflet-head > * { position: relative; }

		.coupon {
			position: relative;
			margin: 0;
			padding: 1.5rem 1.25rem 0.75rem;
			list-style: none;
			border: 2px dashed #151515;
			font-size: 1.05rem;
		}
		.coupon::before {
			content: "Cut along the dotted line";
			position: absolute;
			top: -0.75rem;
			left: 1rem;
			padding: 0 0.5rem;
			background: var(--paper);
			font-size: 0.75rem;
			font-weight: 700;
		}
		.coupon li { display: flex; gap: 1rem; padding: 0.6rem 0; }
		.coupon li + li { border-top: 1px dotted #8a8a84; }
		.coupon span { flex: 0 0 6.5rem; font-weight: 700; }

		/* ---------- Motto ---------- */
		.motto {
			width: min(52rem, calc(100% - 2rem));
			margin: 1rem auto 4rem;
			font-size: clamp(1.4rem, 8.5vw, 4.5rem);
			white-space: nowrap;
			font-weight: 700;
			letter-spacing: -0.045em;
			line-height: 0.92;
			text-align: center;
			color: light-dark(#151515, #f1f1ee);
		}

		/* ---------- Footer ---------- */
		footer { background: var(--black); color: var(--white); }

		.hazard {
			height: 0.7rem;
			background: repeating-linear-gradient(45deg, var(--yellow) 0 14px, var(--black) 14px 28px);
		}

		footer p {
			margin: 0;
			padding: 1.25rem 1rem 1.75rem;
			text-align: center;
			font-size: 0.9rem;
		}

		/* ---------- Small screens ---------- */
		@media (max-width: 760px) {
			.logo { display: none; }
		}

		@media (max-width: 520px) {
			.cis-board { font-size: 0.85rem; }
			.cis-rank { width: 2.2em; }
			.cis-time { width: 3.6em; }
			.cis-plat { width: 1.8em; }
			.cis-status { width: 5.2em; }
			.cis-dest { padding-left: 0.5em; }
			.leaflet-head, .leaflet-body { padding-left: 1.1rem; padding-right: 1.1rem; }
			.leaflet-body { padding-top: 1.25rem; }
			.project { grid-template-columns: 2.2rem 1fr; column-gap: 0.75rem; }
			.project::before { width: 2.2rem; height: 2.2rem; font-size: 1.2rem; }
			.sticker { width: 4rem; height: 4rem; font-size: 0.95rem; right: 1rem; }
			.coupon li { flex-direction: column; gap: 0.1rem; }
			.coupon span { flex: none; }
		}

		@media (prefers-reduced-motion: reduce) {
			html { scroll-behavior: auto; }
			.cis-blink { animation: none; }
			.cis-scroll-container { overflow: visible; }
			.cis-scroll-row { flex-wrap: wrap; }
			.cis-scroll-text { animation: none; transform: none; white-space: normal; }
		}
	</style>
</head>
<body>

<header class="hero">
	<div class="nameboard sign sign--intercity">
		<span class="stripes" aria-hidden="true"></span>
		<svg class="logo" viewBox="497 15 106 115" fill="currentColor" aria-hidden="true" focusable="false">
			<path d="M562.34,91.84c-0.38,0.49-0.76,0.98-1.13,1.47c-0.31,0.41-0.57,0.85-0.64,1.37h18.78 c0.63-0.9,1.23-1.82,1.76-2.78c0.01-0.02,0.02-0.04,0.03-0.06H562.34z"/>
			<path d="M562.97,88.23c-0.03,0.51,0.07,1,0.23,1.48c0.16,0.48,0.08,0.92-0.22,1.32h18.62c0.17-0.35,0.31-0.72,0.3-1.13 c-0.01-0.56,0-1.11,0.02-1.67H562.97z"/>
			<path d="M560.46,95.49c-0.16,0.77-0.52,1.46-1.03,2.11c-0.23,0.29-0.45,0.59-0.63,0.9h17.63 c0.16-0.21,0.33-0.42,0.49-0.63c0.62-0.79,1.24-1.58,1.84-2.38H560.46z"/>
